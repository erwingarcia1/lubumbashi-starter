# Copy to .env.local (never committed). Every value below is a placeholder.
# Environment: development | test | demo | production. The mock payment provider and the seed
# refuse to run when APP_ENV=production (CLAUDE.md invariant 1).
APP_ENV=development

# Local stack: `supabase start`, then `supabase status` prints the real local values.

# Public URL of this app (used later for links in SMS, receipts and QR codes)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Auth for admin users from M3, Storage for photos from M4)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Password given to the seeded admin logins (local/demo only; never used in production)
SEED_ADMIN_PASSWORD=Lubumbashi2026!

# Postgres through Drizzle.
# DATABASE_URL            runtime connection as `app_login` (member of `app_rw`: no DDL, no
#                         UPDATE/DELETE/TRUNCATE on audit_log, provider_confirmations, receipts).
# DATABASE_URL_MIGRATIONS owner connection, used only by `pnpm db:generate` and `pnpm db:migrate`.
DATABASE_URL=postgresql://app_login:change-me-local@127.0.0.1:54322/postgres
DATABASE_URL_MIGRATIONS=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Password of the runtime role `app_login`; `pnpm db:migrate` creates/updates the role with it.
APP_DB_PASSWORD=change-me-local

# Next.js anonymous telemetry: off for a municipal system
NEXT_TELEMETRY_DISABLED=1

# HMAC key for agent session cookies (32+ chars). Rotating it logs every agent out.
AGENT_SESSION_SECRET=change-me-32-chars-minimum-for-hmac-signing

# Docker Compose deploy only (docs/OPERATIONS.md): domain served by Caddy with automatic TLS
APP_DOMAIN=recouvrement.example.cd

# Payments: providers switched on (only `mock` exists; refused when APP_ENV=production) and
# channels offered in the UI; a pending payment expires after PAYMENT_EXPIRY_HOURS (D28).
PAYMENT_PROVIDERS=mock
PAYMENT_CHANNELS=mpesa,airtel,orange
PAYMENT_EXPIRY_HOURS=24

# Notifications (M7): SMS provider (`console` prints the message; real providers later) and the
# bearer token the scheduler sends to POST /api/cron/notifications.
SMS_PROVIDER=console
CRON_SECRET=change-me-cron-secret
