{
  "name": "lubumbashi-tax",
  "version": "0.0.0",
  "private": true,
  "description": "Plateforme de recouvrement \u2014 Ville de Lubumbashi",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts && tsx scripts/db-roles.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:roles": "tsx scripts/db-roles.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "demo:obligations": "tsx scripts/print-obligations.ts",
    "db:reset": "tsx scripts/db-reset.ts && pnpm db:migrate && pnpm db:seed",
    "notify:worker": "tsx scripts/notify-worker.ts",
    "worker": "tsx scripts/worker.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "test:e2e:remote": "playwright test tests/e2e/smoke.spec.ts tests/e2e/admin.spec.ts tests/e2e/agent.spec.ts tests/e2e/collect.spec.ts tests/e2e/dashboard.spec.ts tests/e2e/reconciliation.spec.ts tests/e2e/audit-reports.spec.ts --workers=2"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@next/env": "16.3.5",
    "@node-rs/argon2": "2.2.1",
    "@react-pdf/renderer": "4.9.0",
    "@serwist/next": "9.5.12",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "leaflet": "1.9.4",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "pg-boss": "12.31.0",
    "qrcode": "1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "5.0.0",
    "serwist": "9.5.12",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "^6.2.5",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
